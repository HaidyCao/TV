<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TV" parent="@style/Theme.Leanback" />
    
    <style name="Theme.TV.Playback" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    
    <style name="Theme.TV.Phone" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#FF6200EE</item>
        <item name="colorPrimaryDark">#FF3700B3</item>
        <item name="colorAccent">#FF03DAC5</item>
    </style>

    <style name="Theme.TV.Phone.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.TV.SettingsDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">@color/card_info_background</item>
        <item name="android:windowBackground">@drawable/tv_settings_dialog_background</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C8FFFFFF</item>
        <item name="android:colorAccent">@color/focus_accent</item>
        <item name="colorAccent">@color/focus_accent</item>
        <item name="colorControlActivated">@color/focus_accent</item>
    </style>
</resources>
