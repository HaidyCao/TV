<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/default_background"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:descendantFocusability="afterDescendants"
    android:paddingTop="24dp"
    android:paddingBottom="64dp">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/settings_header"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_settings_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/settings_source_card_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_source_current_label"
                android:textColor="#C8FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/source_current_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:text="" />

            <TextView
                android:id="@+id/source_current_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:breakStrategy="high_quality"
                android:textColor="#D0FFFFFF"
                android:textSize="16sp"
                android:text="" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/settings_source_edit_label"
                android:textColor="#C8FFFFFF"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/source_url_focus_container"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/tv_settings_url_row_background"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/source_runtime_status"
                android:nextFocusForward="@id/source_runtime_status"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/source_url_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:hint="@string/source_url_hint"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B8FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/edit_source_url"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="textUri"
                android:longClickable="false"
                android:maxLines="1"
                android:singleLine="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/source_runtime_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/tv_settings_url_row_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/btn_refresh_source"
                android:nextFocusForward="@id/btn_refresh_source"
                android:padding="14dp"
                android:text="@string/settings_source_loading"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/source_channel_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/tv_settings_url_row_background"
                android:nextFocusDown="@id/btn_refresh_source"
                android:nextFocusForward="@id/btn_refresh_source"
                android:padding="14dp"
                android:text="@string/settings_source_no_channel_stats"
                android:textColor="#D0FFFFFF"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btn_refresh_source"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/tv_settings_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/btn_test_source"
                android:nextFocusForward="@id/btn_test_source"
                android:nextFocusUp="@id/source_runtime_status"
                android:text="@string/settings_refresh_source"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/source_test_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="#D0FFFFFF"
                android:textSize="17sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_test_source"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/tv_settings_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusDown="@id/btn_restore_source"
                    android:nextFocusForward="@id/btn_save"
                    android:nextFocusRight="@id/btn_save"
                    android:nextFocusUp="@id/btn_refresh_source"
                    android:minWidth="0dp"
                    android:text="@string/source_test"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/tv_settings_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusDown="@id/btn_restore_source"
                    android:nextFocusForward="@id/btn_restore_source"
                    android:nextFocusLeft="@id/btn_test_source"
                    android:nextFocusUp="@id/btn_test_source"
                    android:minWidth="0dp"
                    android:text="@string/save_and_refresh"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/source_previous_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="#D0FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_restore_source"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/tv_settings_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/preview_mode_off"
                android:nextFocusForward="@id/preview_mode_off"
                android:nextFocusUp="@id/btn_save"
                android:text="@string/settings_restore_source"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="start"
                android:text="@string/source_format_hint"
                android:textColor="#B8FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/tv_settings_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/settings_preview_card_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preview_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/tv_preview_mode_intro"
                android:textColor="#C8FFFFFF"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/preview_focus_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/preview_mode_off"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/tv_settings_switch_focus_background"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/btn_restore_source"
                    android:nextFocusDown="@id/preview_mode_focused"
                    android:nextFocusForward="@id/preview_mode_focused"
                    android:buttonTint="#FFFFFF"
                    android:minHeight="76dp"
                    android:padding="16dp"
                    android:text="@string/tv_preview_mode_off"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/preview_mode_focused"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/tv_settings_switch_focus_background"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/preview_mode_off"
                    android:nextFocusDown="@id/preview_mode_full"
                    android:nextFocusForward="@id/preview_mode_full"
                    android:buttonTint="#FFFFFF"
                    android:minHeight="76dp"
                    android:padding="16dp"
                    android:text="@string/tv_preview_mode_focused"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/preview_mode_full"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/tv_settings_switch_focus_background"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@id/preview_mode_focused"
                    android:nextFocusDown="@id/source_cache_status"
                    android:nextFocusForward="@id/source_cache_status"
                    android:buttonTint="#FFFFFF"
                    android:minHeight="76dp"
                    android:padding="16dp"
                    android:text="@string/tv_preview_mode_full"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/tv_settings_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_data_card_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/source_cache_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_settings_url_row_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/btn_clear_recent_watches"
                android:nextFocusForward="@id/btn_clear_recent_watches"
                android:nextFocusUp="@id/preview_mode_full"
                android:padding="16dp"
                android:text="@string/source_cache_empty"
                android:textColor="#D0FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_clear_recent_watches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/tv_settings_url_row_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minHeight="68dp"
                android:nextFocusUp="@id/source_cache_status"
                android:nextFocusDown="@id/settings_about_text"
                android:nextFocusForward="@id/settings_about_text"
                android:padding="16dp"
                android:text="@string/settings_clear_recent_watches"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/tv_settings_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/settings_about_card_title"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_about_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_settings_url_row_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/btn_clear_recent_watches"
                android:padding="16dp"
                android:text="@string/settings_about_summary_placeholder"
                android:textColor="#D0FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
