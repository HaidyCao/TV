<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playback_status_overlay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/player_channel_overlay_background"
    android:gravity="center_horizontal"
    android:minWidth="360dp"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp"
    android:visibility="visible">

    <TextView
        android:id="@+id/playback_status_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxWidth="560dp"
        android:text="@string/playback_connecting"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/playback_action_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/playback_next_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/tv_playback_button_background"
            android:minWidth="128dp"
            android:text="@string/playback_next_channel"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/playback_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/tv_playback_button_background"
            android:minWidth="112dp"
            android:text="@string/playback_retry"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/playback_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/tv_playback_button_background"
            android:minWidth="144dp"
            android:text="@string/playback_back"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
