<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/settings_source_title"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/edit_source_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/source_url_hint"
            android:inputType="textUri"
            android:minHeight="56dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF" />

        <TextView
            android:id="@+id/source_cache_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/source_cache_empty"
            android:textColor="#B8FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_test_source"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="18dp"
            android:backgroundTint="#455A64"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/source_test"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/source_test_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B8FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2196F3"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/save_and_refresh"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/source_previous_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#B8FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_restore_source"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="8dp"
            android:backgroundTint="#455A64"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/settings_restore_source"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_preview_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/channel_preview_title"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/preview_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="2dp"
            android:text="@string/channel_preview_description"
            android:textColor="#B8FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="start"
            android:text="@string/source_format_hint"
            android:textColor="#88FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
