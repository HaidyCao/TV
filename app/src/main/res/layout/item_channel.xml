<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#1F1F1F"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/video_container"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#2A2A2A">

            <!-- A channel-specific fallback, shown when the playlist has no logo. -->
            <TextView
                android:id="@+id/channel_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/channel_placeholder"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:padding="12dp"
                android:textColor="#EAF2FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Playlist-provided channel logo, when available. -->
            <ImageView
                android:id="@+id/channel_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.8" />

            <!-- 视频播放器，必须在图片上层但占位图下面 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <ViewStub
                android:id="@+id/player_stub"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 直播标识 -->
            <TextView
                android:id="@+id/live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/live_badge_background"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:text="@string/live_badge"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/favorite_badge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/favorite_badge_background"
                android:contentDescription="@string/favorite_badge_description"
                android:padding="5dp"
                android:src="@drawable/ic_favorite"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/channel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:lines="2"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:background="@drawable/category_badge_background"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="#00BCD4"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
