<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A4A58" />
            <stroke
                android:width="2dp"
                android:color="@color/focus_accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F2B35" />
            <stroke
                android:width="1dp"
                android:color="#617383" />
            <corners android:radius="6dp" />
        </shape>
    </item>

</selector>
