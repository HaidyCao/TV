<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#243541" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#243541" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#172631" />
            <stroke
                android:width="1dp"
                android:color="#405463" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
