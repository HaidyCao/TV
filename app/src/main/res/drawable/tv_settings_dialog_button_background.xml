<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#344957" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#405461" />
            <stroke
                android:width="2dp"
                android:color="@color/focus_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#243541" />
            <stroke
                android:width="1dp"
                android:color="#73818B" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
