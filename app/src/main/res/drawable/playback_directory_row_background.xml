<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#42586B" />
            <stroke
                android:width="2dp"
                android:color="@color/focus_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#293B4A" />
            <stroke
                android:width="1dp"
                android:color="#7892A6" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#15202A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
